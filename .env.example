# 로컬 개발용 기본값이다. 비밀값이 아니다. 복사해서 .env로 쓴다: cp .env.example .env
# 프로젝트를 나눠 동시에 띄울 때(docker compose -p w1 ...)는 호스트 포트를 서로 다르게 바꾼다.

GATEWAY_HOST_PORT=8080
MOCK_PG_HOST_PORT=8090
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9094
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# 서비스마다 앱 계정(DML)과 Flyway 계정(DDL + DML)을 나눈다
MYSQL_ROOT_PASSWORD=root-local
USER_APP_PASSWORD=user-app-local
USER_FLYWAY_PASSWORD=user-flyway-local
EVENT_APP_PASSWORD=event-app-local
EVENT_FLYWAY_PASSWORD=event-flyway-local
RESERVATION_APP_PASSWORD=reservation-app-local
RESERVATION_FLYWAY_PASSWORD=reservation-flyway-local
PAYMENT_APP_PASSWORD=payment-app-local
PAYMENT_FLYWAY_PASSWORD=payment-flyway-local
NOTIFICATION_APP_PASSWORD=notification-app-local
NOTIFICATION_FLYWAY_PASSWORD=notification-flyway-local

GRAFANA_ADMIN_PASSWORD=grafana-local

# 비워 두면 fixture, Mock 모드로 동작한다
KOPIS_API_KEY=
LLM_API_KEY=
