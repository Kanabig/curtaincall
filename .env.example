# 로컬 개발용 기본값이다. 비밀값이 아니다. 복사해서 .env로 쓴다: cp .env.example .env
# 프로젝트를 나눠 동시에 띄울 때(docker compose -p w1 ...)는 호스트 포트를 서로 다르게 바꾼다.

GATEWAY_HOST_PORT=8080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9094
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

MYSQL_ROOT_PASSWORD=root-local
USER_DB_PASSWORD=user-local
EVENT_DB_PASSWORD=event-local
RESERVATION_DB_PASSWORD=reservation-local
PAYMENT_DB_PASSWORD=payment-local
NOTIFICATION_DB_PASSWORD=notification-local

# 비워 두면 fixture, Mock 모드로 동작한다
KOPIS_API_KEY=
LLM_API_KEY=
